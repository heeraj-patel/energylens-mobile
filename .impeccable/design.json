  "narrative": {
    "northStar": "Clear Energy at Home",
    "overview": "The approved fourteen HTML pages form a light, compact mobile system. Cool white and pale blue surfaces give energy and cost information room to scan. Deep teal identifies actions and interface icons, while sky blue marks the selected bottom destination; green and warm warning colors distinguish useful use and waste in the data. The visual tone is clear, calm, and approachable.\n\nThe source pages are the authority for future mobile work. Build new work in this system, then check it against the supplied pages and actual device captures. The older emerald Flutter system, four-section navigation, and the supplied Glacier dark-glass prose describe earlier or conflicting directions. They are not the visual reference for new customer pages.",
    "keyCharacteristics": [
      "light ice-blue surfaces",
      "Manrope headings with Source Sans 3 content and Rubik labels",
      "compact cards and metric tiles",
      "five-part bottom navigation",
      "soft borders and restrained shadows"
    ],
    "rules": [
      {
        "name": "The Source Palette Rule",
        "body": "Reuse the values in the frontmatter and the approved page HTML. Do not substitute the earlier emerald navigation palette or the dark-glass colors from the conflicting source prose.",
        "section": "colors"
      },
      {
        "name": "The Three-Font Rule",
        "body": "Preserve each family's role; do not replace the pages with platform system text or use Manrope for body paragraphs.",
        "section": "typography"
      },
      {
        "name": "The Five-Section Rule",
        "body": "Dashboard, Devices, Efficiency, Tips, and Settings remain the primary navigation. Their named variants are separate page states, not extra bottom destinations.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do use the fourteen approved HTML pages and bundled assets as the visual and wording reference for new mobile work.",
      "Do use Dashboard HTML and Knowledge HTML FAQ where their PNGs disagree; the owner chose those variants.",
      "Do keep the initial page copy, sample values, font roles, and component states exact until the owner approves a change.",
      "Do compare the resulting screen on a physical iPhone in Release mode."
    ],
    "donts": [
      "Don't reuse the earlier four-section emerald Flutter design system as new-screen guidance.",
      "Don't apply the dark glassmorphism prose from the supplied Glacier DESIGN.md to these light HTML pages.",
      "Don't treat sample energy values or savings in the visual references as measured evidence."
    ]
  }
