# Copy to .env-local and chmod 600 .env-local. The deployment script loads it.
# Only public build settings below are compiled into the Mobile app.
# Keep account passwords, Cloud database URLs, and signing keys in their owning
# server repository; Mobile stores login and pairing credentials in Keychain.

# Local preview bypasses account sign-in. Use false for authenticated builds.
ENERGYLENS_LOCAL_PILOT=true
ENERGYLENS_DESIGN_TOUR=false
ENERGYLENS_DESIGN_TOUR_DWELL_SECONDS=8

# Set the verified HTTPS API origin before using --cloud.
ENERGYLENS_CLOUD_API_URL=
ENERGYLENS_CLOUD_LOCAL_AUTH_ENABLED=false
ENERGYLENS_CLOUD_DEV_AUTH_ENABLED=false
ENERGYLENS_APP_ENV=dev
# Optional lowercase SHA-256 leaf certificate fingerprint for development TLS.
ENERGYLENS_CLOUD_DEV_CERT_SHA256=
# Required only when pasting first-party email verification/reset links.
ENERGYLENS_CLOUD_LOCAL_AUTH_LINK_ORIGIN=

# OIDC profile, when used instead of first-party authentication.
ENERGYLENS_OIDC_ISSUER=
ENERGYLENS_OIDC_AUDIENCE=
ENERGYLENS_OIDC_CLIENT_ID=
ENERGYLENS_OIDC_REDIRECT_URL=io.energylens.app://login-callback

# Optional local Hub bootstrap. Pin format: https://IP:PORT#sha256=HEX_DIGEST
ENERGYLENS_HUB_URL=
ENERGYLENS_POSTAL_CODE=
# Simulator bootstrap token is imported at runtime; never compiled into the app.
ENERGYLENS_HUB_TOKEN=

# Optional launcher/tool settings. Explicit --team overrides project signing.
# DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
